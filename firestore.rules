rules_version = '2';
// Kairos のアクセス制御（.github/workflows/codes.yml が自動で反映する）
service cloud.firestore {
  match /databases/{database}/documents {

    // 通知の購読（端末が自分で登録する。読み出しと削除は送信ジョブだけ）
    match /kairos_subs/{id} {
      allow create: if subShape();
    }
    // 管理者の端末の購読（点検の失敗・報告の到着を知らせる）
    match /kairos_owner_subs/{id} {
      allow create: if subShape();
    }
    function subShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'ua', 'created'])
        && d.endpoint is string && d.endpoint.size() < 1000 && d.endpoint.matches('https://.*')
        && d.p256dh is string && d.p256dh.size() < 200
        && d.auth is string && d.auth.size() < 100;
    }

    // アクセスコードごとの登録端末（1コード3台まで）
    match /kx_slots/{cid} {
      allow get: if request.auth != null;
      allow update: if request.auth != null && slotChange();
    }

    // コードごとのデータ鍵（登録された端末だけが読める）
    match /kx_keys/{cid} {
      allow get: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/kx_slots/$(cid)).data.devices;
    }

    // ★保存・メモ（端末で暗号化した塊。登録された端末だけが読み書きできる）
    match /kx_marks/{cid} {
      allow get, create, update: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/kx_slots/$(cid)).data.devices
        && (request.method == 'get'
            || (request.resource.data.keys().hasOnly(['b', 'at'])
                && request.resource.data.b is string
                && request.resource.data.b.size() < 800000));
    }

    // 誤り・要望の報告（端末で暗号化した塊。登録された端末が送り、管理者の端末だけが読める）
    match /kx_feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['b', 'cid', 'at'])
        && request.resource.data.b is string
        && request.resource.data.b.size() < 20000
        && request.resource.data.cid is string
        && request.resource.data.at == request.time
        && request.auth.uid in get(/databases/$(database)/documents/kx_slots/$(request.resource.data.cid)).data.devices;
      allow read, delete: if request.auth != null && isOwner();
    }

    // 管理者の枠の場所（端末からは読めない。ルールの中でだけ使う）
    match /kx_admin/{id} {
      allow read, write: if false;
    }

    function isOwner() {
      let oc = get(/databases/$(database)/documents/kx_admin/owner).data.cid;
      return request.auth.uid in get(/databases/$(database)/documents/kx_slots/$(oc)).data.devices;
    }

    function slotChange() {
      let me = request.auth.uid;
      let before = resource.data.devices;
      let after = request.resource.data.devices;
      let d = after.diff(before);
      let top = request.resource.data.diff(resource.data).affectedKeys();
      let sameSwap = request.resource.data.swapAt == resource.data.swapAt;
      return top.hasOnly(['devices', 'swapAt']) && (
        // 使ったことを記録する
        (sameSwap && d.addedKeys().size() == 0 && d.removedKeys().size() == 0
          && d.changedKeys().hasOnly([me]) && me in before)
        // 空きがあれば登録する
        || (sameSwap && d.addedKeys().hasOnly([me]) && d.removedKeys().size() == 0
          && d.changedKeys().size() == 0 && after.size() <= 3)
        // この端末の登録を外す
        || (sameSwap && d.removedKeys().hasOnly([me]) && d.addedKeys().size() == 0
          && d.changedKeys().size() == 0)
        // 3台で埋まっているとき、30日に1回だけ1台と入れ替える（機種変更）
        || (d.addedKeys().hasOnly([me]) && d.removedKeys().size() == 1
          && d.changedKeys().size() == 0 && before.size() == 3
          && request.time > resource.data.swapAt + duration.value(30, 'd')
          && request.resource.data.swapAt == request.time)
      );
    }
  }
}
